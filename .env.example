DEUTSCHOS_DATABASE_URL=sqlite:///./data/deutschos.sqlite3
DEUTSCHOS_OLLAMA_BASE_URL=http://127.0.0.1:11434
DEUTSCHOS_OLLAMA_MODEL=
DEUTSCHOS_TIMEZONE=Europe/Berlin
DEUTSCHOS_CORS_ORIGINS=http://127.0.0.1:3000,http://localhost:3000
