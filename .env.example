DEUTSCHOS_DATABASE_URL=sqlite:///./data/deutschos.sqlite3
DEUTSCHOS_OLLAMA_BASE_URL=http://127.0.0.1:11434
DEUTSCHOS_OLLAMA_MODEL=qwen3:14b
DEUTSCHOS_TIMEZONE=Europe/Berlin
DEUTSCHOS_CORS_ORIGINS=http://127.0.0.1:3000,http://localhost:3000
DEUTSCHOS_BACKUP_DIR=./backups
DEUTSCHOS_EDUCATIONAL_MATERIALS_DIR=./material educativo
DEUTSCHOS_EDUCATIONAL_LIBRARY_RUNTIME_DIR=./var/educational-library
DEUTSCHOS_EDUCATIONAL_LIBRARY_SCAN_ON_STARTUP=true
DEUTSCHOS_EDUCATIONAL_LIBRARY_SCAN_INTERVAL_SECONDS=900
DEUTSCHOS_EDUCATIONAL_LIBRARY_EMBEDDING_MODEL=
DEUTSCHOS_EDUCATIONAL_LIBRARY_TEACHER_MAX_SEARCH_QUERIES=6
DEUTSCHOS_EDUCATIONAL_LIBRARY_TEACHER_MAX_SOURCES=5
DEUTSCHOS_EDUCATIONAL_LIBRARY_TEACHER_MAX_CHUNKS=10
DEUTSCHOS_EDUCATIONAL_LIBRARY_TEACHER_MAX_CHUNKS_PER_SOURCE=2
DEUTSCHOS_EDUCATIONAL_LIBRARY_TEACHER_MAX_CONTEXT_CHARACTERS=18000
NEXT_PUBLIC_API_URL=http://127.0.0.1:8000
